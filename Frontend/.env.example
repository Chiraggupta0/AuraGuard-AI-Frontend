# Python vision microservice (Phase 3) — YOLO, separate server from VITE_API_BASE_URL
VITE_VISION_SERVICE_URL=http://localhost:8000

# Python speech microservice (Phase 4) — separate server AND separate port
# from the vision service above; both must run at the same time.
VITE_SPEECH_SERVICE_URL=http://localhost:8001
VITE_SPEECH_CHUNK_INTERVAL_MS=5000
